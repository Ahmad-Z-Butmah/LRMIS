{
  "info": {
    "name": "Student 3 — Surveyor & Registrar Assignment",
    "description": "Postman collection for Student 3 backend endpoints: staff creation, profile retrieval, survey task auto-assign, manual reassign, milestone advancement, field notes, survey report upload, registrar review, analytics (KPIs, delayed applications, surveyor/registrar analytics), spatial filters, CSV exports, and management report.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://127.0.0.1:8001" },
    { "key": "app_id",       "value": "LRMIS-2026-0001" },
    { "key": "staff_id",     "value": "" },
    { "key": "registrar_id", "value": "" }
  ],
  "item": [
    {
      "name": "Student 3 - Create Staff",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/staff/", "host": ["{{base_url}}"], "path": ["staff", ""] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"staff_code\": \"SURV-PM-01\",\n  \"name\": \"Postman Surveyor One\",\n  \"role\": \"surveyor\",\n  \"department\": \"Cadastral Survey\",\n  \"skills\": [\"boundary_survey\", \"gps_mapping\"],\n  \"coverage\": { \"zone_ids\": [\"Z-EAST\", \"Z-WEST\"], \"geo_fence\": null },\n  \"schedule\": {\n    \"timezone\": \"Asia/Jerusalem\",\n    \"shifts\": [\n      { \"day\": \"Sun\", \"start\": \"08:00\", \"end\": \"16:00\" },\n      { \"day\": \"Mon\", \"start\": \"08:00\", \"end\": \"16:00\" }\n    ],\n    \"on_call\": false\n  },\n  \"workload\": { \"active_tasks\": 0, \"max_tasks\": 10 },\n  \"contacts\": { \"email\": \"surv_pm1@test.com\", \"phone\": \"+970599100001\" }\n}"
        }
      },
      "response": []
    },
    {
      "name": "Create Registrar Staff",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/staff/", "host": ["{{base_url}}"], "path": ["staff", ""] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"staff_code\": \"REG-PM-01\",\n  \"name\": \"Postman Registrar One\",\n  \"role\": \"registrar\",\n  \"workload\": { \"active_tasks\": 0, \"max_tasks\": 20 },\n  \"contacts\": { \"email\": \"reg_pm1@test.com\", \"phone\": \"+970599200001\" }\n}"
        }
      },
      "response": []
    },
    {
      "name": "Student 3 - Get Staff",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{staff_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "Student 3 - Auto Assign Surveyor",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/applications/{{app_id}}/auto-assign-surveyor",
          "host": ["{{base_url}}"],
          "path": ["applications", "{{app_id}}", "auto-assign-surveyor"]
        }
      },
      "response": []
    },
    {
      "name": "Student 3 - Manual Reassign Surveyor",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/applications/{{app_id}}/reassign-surveyor",
          "host": ["{{base_url}}"],
          "path": ["applications", "{{app_id}}", "reassign-surveyor"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_surveyor_id\": \"{{staff_id}}\",\n  \"reassigned_by\": \"MGR-ADMIN\",\n  \"reason\": \"Original surveyor on extended leave\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Student 3 - Update Survey Milestone",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/applications/{{app_id}}/survey-milestone",
          "host": ["{{base_url}}"],
          "path": ["applications", "{{app_id}}", "survey-milestone"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"milestone\": \"visit_scheduled\",\n  \"by\": \"{{staff_id}}\",\n  \"note\": \"Site visit scheduled for 2026-06-28\",\n  \"meta\": { \"scheduled_date\": \"2026-06-28\" }\n}"
        }
      },
      "response": []
    },
    {
      "name": "Student 3 - Get Surveyor Tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/staff/{{staff_id}}/survey-tasks",
          "host": ["{{base_url}}"],
          "path": ["staff", "{{staff_id}}", "survey-tasks"]
        }
