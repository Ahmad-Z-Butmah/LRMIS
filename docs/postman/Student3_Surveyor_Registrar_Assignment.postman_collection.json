      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/applications/{{app_id}}/comments",
          "host": ["{{base_url}}"],
          "path": ["applications", "{{app_id}}", "comments"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment_text\": \"Field note: Site boundary markers confirmed. GPS coordinates recorded on parcel P-001.\",\n  \"created_by\": \"{{staff_id}}\",\n  \"actor_type\": \"surveyor\",\n  \"visibility\": \"applicant_visible\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Student 3 - Upload Survey Report",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/applications/{{app_id}}/survey-report",
          "host": ["{{base_url}}"],
          "path": ["applications", "{{app_id}}", "survey-report"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"surveyor_id\": \"{{staff_id}}\",\n  \"task_id\": \"TASK-001\",\n  \"field_notes\": \"Site boundary markers confirmed. GPS coordinates recorded on parcel P-001.\",\n  \"measurements\": { \"area_sqm\": 1198.5, \"perimeter_m\": 139.2 },\n  \"status\": \"pending_review\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "GET /analytics/kpis",
      "request": {
        "method": "GET",
        "header": [],
